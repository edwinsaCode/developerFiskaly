# =============================================================
# esaProperti — environment template
# Salin ke .env lalu isi nilainya sebelum menjalankan docker compose
# JANGAN commit file .env ke git
# =============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=esaproperti
MYSQL_USER=esaproperti
MYSQL_PASSWORD=changeme_app

# ---- Backend ----
# DSN dirakit otomatis di docker-compose dari variabel MySQL di atas.
# Untuk run backend di luar docker, set manual:
# DB_DSN=esaproperti:changeme_app@tcp(localhost:3306)/esaproperti?parseTime=true&loc=Local&charset=utf8mb4

JWT_SECRET=changeme_jwt_secret_min_32_chars
APP_ENV=development        # development | production
PORT=8080

# ---- Port sisi HOST (dev saja) ----
# Hanya menggeser port PUBLISH docker ke host — port di dalam container tetap
# 8080/3000, begitu pula URL antar-container dan nginx production. Ubah ini bila
# 8080/3000 sudah dipakai proyek lain di komputer yang sama, lalu samakan
# frontend/.env (NEXT_PUBLIC_API_URL) dengan BACKEND_HOST_PORT.
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- Production only ----
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
